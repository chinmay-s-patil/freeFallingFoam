FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    master
    {
        type            cyclicAMI;
        value           uniform 0;
    }
    slave
    {
        type            cyclicAMI;
        value           uniform 0;
    }

    // Top = OUTLET: fixed pressure reference
    top
    {
        type            fixedValue;
        value           uniform 0;
    }

    // Bottom = INLET: zero gradient (velocity is prescribed)
    bottom
    {
        type            zeroGradient;
    }

    // Side walls: zero gradient (NOT fixedValue — that overconstrains p)
    sideWalls
    {
        type            zeroGradient;
    }

    rod
    {
        type            zeroGradient;
    }
}

