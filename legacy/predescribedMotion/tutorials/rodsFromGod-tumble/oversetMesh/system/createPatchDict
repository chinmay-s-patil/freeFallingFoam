FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pointSync false;

// Patches to create.
patches
(
    {
        name rod;
        patchInfo
        {
            type wall;
        }
        constructFrom patches;
        patches ( "patch_1_.*" );
    }
    {
        name overset;
        patchInfo
        {
            type overset;
        }
        constructFrom patches;
        patches ( "patch_2_.*" );
    }
    {
        name defaultFaces;
        patchInfo
        {
            type patch;
        }
        constructFrom patches;
        patches ( "patch_0_0" );
    }
);


