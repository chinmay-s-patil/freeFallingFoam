xMin    -1.9000000000000001;
xMax    1.9000000000000001;
yMin    -7.0;
yMax    7.0;
zMin    -1.8982240555854446;
zMax    1.8982240555854444;
cellsX  19;
cellsY  70;
cellsZ  19;

vertices
(
    ( $xMin  $yMin  $zMin )
    ( $xMax  $yMin  $zMin )
    ( $xMax  $yMax  $zMin )
    ( $xMin  $yMax  $zMin )
    ( $xMin  $yMin  $zMax )
    ( $xMax  $yMin  $zMax )
    ( $xMax  $yMax  $zMax )
    ( $xMin  $yMax  $zMax )
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($cellsX $cellsY $cellsZ) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    xMin
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }
    xMax
    {
        type patch;
        faces
        (
            (1 5 6 2)
        );
    }
    yMin
    {
        type patch;
        faces
        (
            (0 1 2 3)
        );
    }
    yMax
    {
        type patch;
        faces
        (
            (4 5 6 7)
        );
    }
    zMin
    {
        type patch;
        faces
        (
            (1 0 4 5)
        );
    }
    zMax
    {
        type patch;
        faces
        (
            (3 7 6 2)
        );
    }
);

