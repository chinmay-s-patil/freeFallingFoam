FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pointSync false;

// Patches to create.
patches
(
    {
        name            overset;
        patchInfo { type overset; }
        constructFrom   patches;
        patches         (overset);
    }
    {
        name            top;
        patchInfo { type patch; }
        constructFrom   patches;
        patches         (top);
    }
    {
        name            bottom;
        patchInfo { type patch; }
        constructFrom   patches;
        patches         (bottom);
    }
    {
        name            farWall;
        patchInfo { type wall; }
        constructFrom   patches;
        patches         (farWall);
    }
    {
        name            rod;
        patchInfo { type wall; }
        constructFrom   patches;
        patches         (rod);
    }
);


