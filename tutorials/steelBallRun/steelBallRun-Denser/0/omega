FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 1.0;

boundaryField
{
    front           { type empty; }
    back            { type empty; }

    top             { type fixedValue; value uniform 1.0; }
    bottom          { type inletOutlet; inletValue uniform 1.0; value uniform 1.0; }

    farWall         { type zeroGradient; }
    sphere          { type omegaWallFunction; value uniform 1.0; }
    symmetry        { type symmetry; }
}

