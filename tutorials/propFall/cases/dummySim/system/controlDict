FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     pimpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

deltaT          1e-4;

endTime         1.0;

writeControl    adjustableRunTime;

writeInterval   1e-4;

purgeWrite      0;

adjustTimeStep  yes;

maxCo           2.0;

maxDeltaT       2e-4;

writeFormat     ascii;

writePrecision  15;

runTimeModifiable true;

libs
(
    "libsixDoFRotatingMotion.so"
    #include "turbulenceLib"
);

functions
{
    Q1
    {
        // Mandatory entries (unmodifiable)
        type            Q;
        libs            (fieldFunctionObjects);

        // Optional (inherited) entries
        field           U;
        result          Q;
        enabled         true;
        log             true;
        timeStart       0;
        timeEnd         1;
        executeControl  timeStep;
        executeInterval 1;

        // Synchronize writeControl with main simulation output
        writeControl    writeTime;
        writeInterval   1; // This is now optional, as writeTime automatically handles it.

        // Omit the region entry to apply to all regions
    }

    forceCoeffs1
    {
        // Mandatory entries
        type            forceCoeffs;
        libs            ("libforces.so");
        patches         (propeller);


        // Optional entries

        // Field names
        p               p;
        U               U;
        rho             rhoInf;
        rhoInf          1.225;

        // Reference pressure [Pa]
        pRef            0;

        // Include porosity effects?
        porosity        no;

        // Store and write volume field representations of forces and moments
        writeFields     no;

        // Synchronize writeControl with main simulation output
        writeControl    writeTime;

        // Centre of rotation for moment calculations
        CofR            (0 0 0);

        // Lift direction
        liftDir         (0 0 1);

        // Drag direction (axial, opposing fall)
        dragDir         (0 1 0);

        // Freestream velocity magnitude [m/s]
        magUInf         70;

        // Reference length [m]
        lRef            0.280;

        // Reference area [m2]
        Aref            0.0105638;

        // Spatial data binning
        // - extents given by the bounds of the input geometry
        //binData
        //{
        //    nBin        20;
        //    direction   (1 0 0);
        //    cumulative  yes;
        //}
    }

}

