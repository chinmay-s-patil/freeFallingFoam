FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      zoneID;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform -1;

boundaryField
{
    top             { type zeroGradient; }
    bottom          { type zeroGradient; }
    farWall         { type zeroGradient; }
    rod             { type zeroGradient; }
    overset         { type overset; value uniform -1; }
}

