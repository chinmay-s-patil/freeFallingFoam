#!/bin/bash
cd "${0%/*}" || exit 1   # run from this directory

. "${WM_PROJECT_DIR:?}/bin/tools/RunFunctions"

# ============================================================
#  Root Allwclean — freeFallingFoam master clean script
# ============================================================

echo "========================================================"
echo "  Cleaning freeFallingFoam (src & legacy)"
echo "========================================================"

if [ -f "$PWD/src/Allwclean" ]; then
    "$PWD/src/Allwclean"
fi

if [ -f "$PWD/legacy/predescribedMotion/Allwclean" ]; then
    "$PWD/legacy/predescribedMotion/Allwclean"
fi

echo ""
echo "========================================================"
echo "  Master clean complete"
echo "========================================================"
